f in_Config IsNot Nothing AndAlso in_Config.ContainsKey(&quot;ScreenshotFolder&quot;) Then folder = Convert.ToString(in_Config(&quot;ScreenshotFolder&quot;))&#xA;&#xA;If folder = &quot;&quot; Then&#xA;    Dim outRoot As String = Environment.GetEnvironmentVariable(&quot;BLV_OUTPUT_ROOT&quot;)&#xA;&#xA;    If String.IsNullOrWhiteSpace(outRoot) Then&#xA;        ' Read OutputRoot out of the local override file without a JSON dependency:&#xA;        ' this code runs in the failure handler, where the fewer moving parts the better.&#xA;        Dim localCfg As String = Path.Combine(Directory.GetCurrentDirectory(), &quot;Data&quot;, &quot;Config.local.json&quot;)&#xA;        If File.Exists(localCfg) Then&#xA;            ' ChrW(34) rather than an escaped quote literal: this body is stored inside a&#xA;            ' XAML attribute, and nested quote escaping is unreadable there and in Studio.&#xA;            Dim dq As Char = ChrW(34)&#xA;            Dim txt As String = File.ReadAllText(localCfg)&#xA;            Dim k As Integer = txt.IndexOf(dq &amp; &quot;OutputRoot&quot; &amp; dq)&#xA;            If k &gt;= 0 Then&#xA;                Dim c As Integer = txt.IndexOf(&quot;:&quot;c, k)&#xA;                Dim q1 As Integer = -1&#xA;                If c &gt;= 0 Then q1 = txt.IndexOf(dq, c + 1)&#xA;                Dim q2 As Integer = -1&#xA;                If q1 &gt;= 0 Then q2 = txt.IndexOf(dq, q1 + 1)&#xA;                If q2 &gt; q1 Then outRoot = txt.Substring(q1 + 1, q2 - q1 - 1).Replace(&quot;\\&quot;, &quot;\&quot;)&#xA;            End If&#xA;        End If&#xA;    End If&#xA;&#xA;    If String.IsNullOrWhiteSpace(outRoot) Then outRoot = Path.Combine(Directory.GetCurrentDirectory(), &quot;Data&quot;, &quot;Output&quot;)&#xA;    If Not Path.IsPathRooted(outRoot) Then outRoot = Path.GetFullPath(Path.Combine(Directory.GetCurrentDirectory(), outRoot))&#xA;    folder = Path.Combine(outRoot, &quot;Screenshots&quot;)&#xA;End If&#xA;&#xA;Directory.CreateDirectory(folder)&#xA;out_Path = Path.Combine(folder, &quot;Failure_&quot; &amp; DateTime.UtcNow.ToString(&quot;yyyyMMdd'T'HHmmss'Z'&quot;, CultureInfo.InvariantCulture) &amp; &quot;.png&quot;)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[Config]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="out_Path">[screenshotPath]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:TakeScreenshot DisplayName="Take Screenshot - failure" Screenshot="[failureImage]" /><ui:SaveImage DisplayName="Save Image - failure" FileName="[screenshotPath]" Image="[failureImage]" /><ui:LogMessage DisplayName="Log - [MAIN] Failure screenshot saved" Level="Info" Message="[&quot;[MAIN] Failure screenshot saved: &quot; &amp; screenshotPath]" /></Sequence></TryCatch.Try><TryCatch.Catches><Catch x:TypeArguments="s:Exception"><ActivityAction x:TypeArguments="s:Exception"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="shotError" /></ActivityAction.Argument><ui:LogMessage DisplayName="Log - [MAIN] Could not capture a failure screenshot" Level="Warn" Message="[&quot;[MAIN] Could not capture a failure screenshot: &quot; &amp; shotError.Message]" /></ActivityAction></Catch></TryCatch.Catches></TryCatch><Rethrow DisplayName="Rethrow" /></Sequence></ActivityAction></Catch></TryCatch.Catches></TryCatch><ui:LogMessage DisplayName="Log - === BlockchainLogisticsValidator finished ===" Level="Info" Message="[&quot;=== BlockchainLogisticsValidator finished ===&quot;]" /></Sequence>
