  <Sequence DisplayName="08 - Generate PDF audit report"><Sequence.Variables><Variable x:TypeArguments="x:String" Name="htmlPath" /><Variable x:TypeArguments="x:String" Name="configHash" /><Variable x:TypeArguments="x:String" Name="summary" /></Sequence.Variables><ui:InvokeCode DisplayName="Invoke Code - render the audit report" Language="VBNet" Code="' A formal, printable audit document - the artefact a regulator or customs officer&#xA;' would actually file. Deliberately different from the dashboard: it pins the exact&#xA;' configuration used (SHA-256 of Config.xlsx), lists every transaction rather than&#xA;' just the exceptions, and closes with the audit chain head so any later alteration&#xA;' of the trail can be detected against this paper copy.&#xA;Dim enc As Func(Of Object, String) = Function(o) System.Net.WebUtility.HtmlEncode(Convert.ToString(o))&#xA;&#xA;Dim cfgPath As String = Path.Combine(Convert.ToString(in_Config(&quot;ProjectRoot&quot;)), &quot;Data&quot;, &quot;Config.xlsx&quot;)&#xA;Dim cfgHash As String = &quot;unavailable&quot;&#xA;If File.Exists(cfgPath) Then&#xA;    ' ReadWrite sharing: Excel may still hold the workbook open from the read step.&#xA;    Using fs As New FileStream(cfgPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite)&#xA;        Using sha As SHA256 = SHA256.Create()&#xA;            cfgHash = BitConverter.ToString(sha.ComputeHash(fs)).Replace(&quot;-&quot;, &quot;&quot;).ToLowerInvariant()&#xA;        End Using&#xA;    End Using&#xA;End If&#xA;&#xA;Dim shipments As New HashSet(Of String)&#xA;Dim firstAt As DateTime = DateTime.MaxValue&#xA;Dim lastAt As DateTime = DateTime.MinValue&#xA;For Each r As DataRow In in_dtResults.Rows&#xA;    shipments.Add(Convert.ToString(r(&quot;ShipmentID&quot;)))&#xA;    Dim t As DateTime = Convert.ToDateTime(r(&quot;ChainTimestampUtc&quot;))&#xA;    If t &lt; firstAt Then firstAt = t&#xA;    If t &gt; lastAt Then lastAt = t&#xA;Next&#xA;Dim period As String = If(in_dtResults.Rows.Count = 0, &quot;-&quot;, _&#xA;    firstAt.ToString(&quot;yyyy-MM-dd HH:mm&quot;) &amp; &quot; to &quot; &amp; lastAt.ToString(&quot;yyyy-MM-dd HH:mm&quot;) &amp; &quot; UTC&quot;)&#xA;&#xA;Dim sb As New StringBuilder()&#xA;sb.AppendLine(&quot;&lt;!DOCTYPE html&gt;&lt;html lang='en'&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;title&gt;Audit Report &quot; &amp; enc(in_Config(&quot;RunId&quot;)) &amp; &quot;&lt;/title&gt;&lt;style&gt;&quot;)&#xA;sb.AppendLine(&quot;@page{size:A4;margin:16mm 14mm 18mm 14mm}&quot;)&#xA;sb.AppendLine(&quot;*{box-sizing:border-box}body{font-family:'Segoe UI',Arial,sans-serif;font-size:10pt;color:#1b1630;margin:0;line-height:1.45}&quot;)&#xA;sb.AppendLine(&quot;h1{font-size:18pt;margin:0 0 2pt;color:#2F1D63}h2{font-size:11.5pt;color:#2F1D63;margin:16pt 0 6pt;border-bottom:1px solid #d9d2e8;padding-bottom:3pt}&quot;)&#xA;sb.AppendLine(&quot;.sub{color:#6b6480;margin-bottom:12pt}&quot;)&#xA;sb.AppendLine(&quot;table{width:100%;border-collapse:collapse;margin:4pt 0}th,td{text-align:left;padding:4pt 6pt;border:1px solid #ddd6ea;vertical-align:top}&quot;)&#xA;sb.AppendLine(&quot;th{background:#efebf7;font-size:8.5pt;text-transform:uppercase;letter-spacing:.3pt}thead{display:table-header-group}tr{page-break-inside:avoid}&quot;)&#xA;sb.AppendLine(&quot;.kv td:first-child{width:32%;font-weight:600;background:#faf8fd}&quot;)&#xA;sb.AppendLine(&quot;.mono{font-family:Consolas,'Courier New',monospace;font-size:8.5pt;word-break:break-all}&quot;)&#xA;sb.AppendLine(&quot;.small td{font-size:8.5pt;padding:2.5pt 5pt}&quot;)&#xA;sb.AppendLine(&quot;.PASS{color:#1a7f4b;font-weight:600}.WARNING{color:#8a6100;font-weight:600}.FAIL{color:#b3261e;font-weight:600}&quot;)&#xA;sb.AppendLine(&quot;.sum{display:flex;gap:8pt;margin:4pt 0}.sum div{flex:1;border:1px solid #ddd6ea;padding:6pt 8pt}.sum b{display:block;font-size:16pt}&quot;)&#xA;sb.AppendLine(&quot;.attest{border:1.5pt solid #2F1D63;padding:8pt 10pt;margin-top:10pt;page-break-inside:avoid}&quot;)&#xA;sb.AppendLine(&quot;.ok{color:#1a7f4b;font-weight:700}.bad{color:#b3261e;font-weight:700}&quot;)&#xA;sb.AppendLine(&quot;&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&quot;)&#xA;&#xA;sb.AppendLine(&quot;&lt;h1&gt;Blockchain Transaction Validation &amp;mdash; Audit Report&lt;/h1&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;div class='sub'&gt;Automated reconciliation of on-chain logistics events against enterprise records&lt;/div&gt;&quot;)&#xA;&#xA;sb.AppendLine(&quot;&lt;h2&gt;1. Document control&lt;/h2&gt;&lt;table class='kv'&gt;&quot;)&#xA;Dim ctl As New List(Of String())&#xA;ctl.Add(New String() {&quot;Report ID&quot;, Convert.ToString(in_Config(&quot;RunId&quot;))})&#xA;ctl.Add(New String() {&quot;Generated (UTC)&quot;, DateTime.UtcNow.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)})&#xA;ctl.Add(New String() {&quot;Generated by&quot;, Convert.ToString(in_Config(&quot;BotIdentity&quot;)) &amp; &quot; on &quot; &amp; Convert.ToString(in_Config(&quot;MachineName&quot;)) &amp; &quot; (&quot; &amp; Convert.ToString(in_Config(&quot;WindowsUser&quot;)) &amp; &quot;)&quot;})&#xA;ctl.Add(New String() {&quot;Data source&quot;, Convert.ToString(in_Config(&quot;DataSourceMode&quot;)) &amp; &quot;, chain id &quot; &amp; Convert.ToString(in_Config(&quot;ChainId&quot;))})&#xA;ctl.Add(New String() {&quot;Contract audited&quot;, Convert.ToString(in_Config(&quot;ContractAddress&quot;))})&#xA;ctl.Add(New String() {&quot;Configuration SHA-256&quot;, cfgHash})&#xA;For Each kv As String() In ctl&#xA;    Dim cls As String = If(kv(0).Contains(&quot;SHA&quot;) OrElse kv(0).Contains(&quot;Contract&quot;), &quot; class='mono'&quot;, &quot;&quot;)&#xA;    sb.AppendLine(&quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; enc(kv(0)) &amp; &quot;&lt;/td&gt;&lt;td&quot; &amp; cls &amp; &quot;&gt;&quot; &amp; enc(kv(1)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;)&#xA;Next&#xA;sb.AppendLine(&quot;&lt;/table&gt;&quot;)&#xA;&#xA;sb.AppendLine(&quot;&lt;h2&gt;2. Scope&lt;/h2&gt;&lt;table class='kv'&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;tr&gt;&lt;td&gt;Transactions examined&lt;/td&gt;&lt;td&gt;&quot; &amp; in_dtResults.Rows.Count &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;tr&gt;&lt;td&gt;Shipments covered&lt;/td&gt;&lt;td&gt;&quot; &amp; shipments.Count &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;tr&gt;&lt;td&gt;On-chain period&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(period) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&quot;)&#xA;&#xA;sb.AppendLine(&quot;&lt;h2&gt;3. Method &amp;mdash; rules applied&lt;/h2&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Rule&lt;/th&gt;&lt;th&gt;Name&lt;/th&gt;&lt;th&gt;Enabled&lt;/th&gt;&lt;th&gt;Severity&lt;/th&gt;&lt;th&gt;Parameters&lt;/th&gt;&lt;th&gt;On failure&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&quot;)&#xA;For Each r As DataRow In in_dtRules.Rows&#xA;    Dim prm As String = String.Join(&quot;, &quot;, New String() {Convert.ToString(r(&quot;Param1&quot;)), Convert.ToString(r(&quot;Param2&quot;))}.Where(Function(x) x &lt;&gt; &quot;&quot;))&#xA;    sb.AppendLine(&quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;RuleID&quot;)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;RuleName&quot;)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;Enabled&quot;)) &amp; _&#xA;        &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;Severity&quot;)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(If(prm = &quot;&quot;, &quot;-&quot;, prm)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;FailAction&quot;)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;)&#xA;Next&#xA;sb.AppendLine(&quot;&lt;/table&gt;&quot;)&#xA;&#xA;sb.AppendLine(&quot;&lt;h2&gt;4. Summary of results&lt;/h2&gt;&lt;div class='sum'&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;div&gt;Examined&lt;b&gt;&quot; &amp; enc(in_Stats(&quot;Total&quot;)) &amp; &quot;&lt;/b&gt;&lt;/div&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;div&gt;Passed&lt;b class='PASS'&gt;&quot; &amp; enc(in_Stats(&quot;Pass&quot;)) &amp; &quot;&lt;/b&gt;&lt;/div&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;div&gt;Warnings&lt;b class='WARNING'&gt;&quot; &amp; enc(in_Stats(&quot;Warning&quot;)) &amp; &quot;&lt;/b&gt;&lt;/div&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;div&gt;Failed&lt;b class='FAIL'&gt;&quot; &amp; enc(in_Stats(&quot;Fail&quot;)) &amp; &quot;&lt;/b&gt;&lt;/div&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;div&gt;Escalated&lt;b&gt;&quot; &amp; enc(in_Stats(&quot;Escalations&quot;)) &amp; &quot;&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&quot;)&#xA;&#xA;sb.AppendLine(&quot;&lt;h2&gt;5. Findings requiring attention&lt;/h2&gt;&quot;)&#xA;Dim nFind As Integer = 0&#xA;Dim fb As New StringBuilder()&#xA;For Each r As DataRow In in_dtResults.Rows&#xA;    Dim st As String = Convert.ToString(r(&quot;ValidationStatus&quot;))&#xA;    If st = &quot;PASS&quot; Then Continue For&#xA;    nFind += 1&#xA;    Dim dec As String = Convert.ToString(r(&quot;HumanDecision&quot;))&#xA;    fb.AppendLine(&quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;ShipmentID&quot;)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;EventName&quot;)) &amp; &quot;&lt;/td&gt;&lt;td class='&quot; &amp; st &amp; &quot;'&gt;&quot; &amp; st &amp; _&#xA;        &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;Severity&quot;)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;FailureReasons&quot;)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(If(dec = &quot;&quot;, &quot;-&quot;, dec)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;)&#xA;Next&#xA;If nFind = 0 Then&#xA;    sb.AppendLine(&quot;&lt;p&gt;No findings. Every transaction passed every enabled rule.&lt;/p&gt;&quot;)&#xA;Else&#xA;    sb.AppendLine(&quot;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Shipment&lt;/th&gt;&lt;th&gt;Milestone&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Severity&lt;/th&gt;&lt;th&gt;Reason&lt;/th&gt;&lt;th&gt;Reviewer decision&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&quot;)&#xA;    sb.Append(fb.ToString())&#xA;    sb.AppendLine(&quot;&lt;/table&gt;&quot;)&#xA;End If&#xA;&#xA;sb.AppendLine(&quot;&lt;h2&gt;6. Transaction register&lt;/h2&gt;&lt;table class='small'&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Shipment&lt;/th&gt;&lt;th&gt;Milestone&lt;/th&gt;&lt;th&gt;On-chain time (UTC)&lt;/th&gt;&lt;th&gt;Transaction&lt;/th&gt;&lt;th&gt;Verdict&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&quot;)&#xA;Dim n As Integer = 0&#xA;For Each r As DataRow In in_dtResults.Rows&#xA;    n += 1&#xA;    Dim h As String = Convert.ToString(r(&quot;TxHash&quot;))&#xA;    Dim shortH As String = If(h.Length &gt; 20, h.Substring(0, 12) &amp; &quot;&amp;hellip;&quot; &amp; h.Substring(h.Length - 6), enc(h))&#xA;    Dim st As String = Convert.ToString(r(&quot;ValidationStatus&quot;))&#xA;    sb.AppendLine(&quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; n &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;ShipmentID&quot;)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; enc(r(&quot;EventName&quot;)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; _&#xA;        Convert.ToDateTime(r(&quot;ChainTimestampUtc&quot;)).ToString(&quot;yyyy-MM-dd HH:mm&quot;) &amp; &quot;&lt;/td&gt;&lt;td class='mono'&gt;&quot; &amp; shortH &amp; _&#xA;        &quot;&lt;/td&gt;&lt;td class='&quot; &amp; st &amp; &quot;'&gt;&quot; &amp; st &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;)&#xA;Next&#xA;sb.AppendLine(&quot;&lt;/table&gt;&quot;)&#xA;&#xA;sb.AppendLine(&quot;&lt;div class='attest'&gt;&lt;h2 style='margin-top:0;border:0'&gt;7. Audit trail attestation&lt;/h2&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;p&gt;Every verdict in this report has been appended to a hash-chained audit log, in which each entry carries the SHA-256 hash of the entry before it. The chain was independently re-verified immediately before this report was produced:&lt;/p&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;p class='&quot; &amp; If(in_ChainValid, &quot;ok&quot;, &quot;bad&quot;) &amp; &quot;'&gt;&quot; &amp; enc(in_ChainReport) &amp; &quot;&lt;/p&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;p&gt;Chain head at time of issue:&lt;br&gt;&lt;span class='mono'&gt;&quot; &amp; enc(in_HeadHash) &amp; &quot;&lt;/span&gt;&lt;/p&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;p style='font-size:8.5pt;color:#6b6480'&gt;To confirm this report has not been superseded or the trail altered, run the verifier against the live audit log and compare its chain head with the value above. Any edit to any historical entry changes every hash after it.&lt;/p&gt;&lt;/div&gt;&quot;)&#xA;sb.AppendLine(&quot;&lt;/body&gt;&lt;/html&gt;&quot;)&#xA;&#xA;Dim folder As String = Convert.ToString(in_Config(&quot;ReportsFolder&quot;))&#xA;Directory.CreateDirectory(folder)&#xA;Dim htmlPath As String = Path.Combine(folder, &quot;AuditReport_&quot; &amp; Convert.ToString(in_Config(&quot;RunId&quot;)) &amp; &quot;.html&quot;)&#xA;File.WriteAllText(htmlPath, sb.ToString(), Encoding.UTF8)&#xA;&#xA;out_HtmlPath = htmlPath&#xA;out_ConfigHash = cfgHash"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[in_Config]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtResults">[in_dtResults]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtRules">[in_dtRules]</InArgument><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Stats">[in_Stats]</InArgument><InArgument x:TypeArguments="x:Boolean" x:Key="in_ChainValid">[in_ChainValid]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_ChainReport">[in_ChainReport]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_HeadHash">[in_HeadHash]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="out_HtmlPath">[htmlPath]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_ConfigHash">[configHash]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:LogMessage DisplayName="Log - [PDF] Configuration fingerprint" Level="Info" Message="[&quot;[PDF] Configuration fingerprint &quot; &amp; configHash.Substring(0, Math.Min(16, configHash.Length)) &amp; &quot;...&quot;]" /><If DisplayName="If - PDF enabled" Condition="[Convert.ToString(in_Config(&quot;PdfReportEnabled&quot;)).Trim().ToUpperInvariant() &lt;&gt; &quot;FALSE&quot;]"><If.Then><Sequence DisplayName="Print to PDF"><ui:InvokeCode DisplayName="Invoke Code - print to PDF with headless Edge" Language="VBNet" Code="' Print the HTML to PDF with a headless Chromium browser. Edge ships with every&#xA;' Windows install, so this needs no PDF library, no Office and no licence. An&#xA;' isolated profile directory avoids colliding with a browser the user already has open.&#xA;Dim browser As String = Convert.ToString(If(in_Config.ContainsKey(&quot;PdfBrowserPath&quot;), in_Config(&quot;PdfBrowserPath&quot;), &quot;&quot;)).Trim()&#xA;If browser = &quot;&quot; OrElse Not File.Exists(browser) Then&#xA;    Dim pf86 As String = Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86)&#xA;    Dim pf As String = Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles)&#xA;    Dim cands() As String = {&#xA;        Path.Combine(pf86, &quot;Microsoft&quot;, &quot;Edge&quot;, &quot;Application&quot;, &quot;msedge.exe&quot;),&#xA;        Path.Combine(pf, &quot;Microsoft&quot;, &quot;Edge&quot;, &quot;Application&quot;, &quot;msedge.exe&quot;),&#xA;        Path.Combine(pf, &quot;Google&quot;, &quot;Chrome&quot;, &quot;Application&quot;, &quot;chrome.exe&quot;),&#xA;        Path.Combine(pf86, &quot;Google&quot;, &quot;Chrome&quot;, &quot;Application&quot;, &quot;chrome.exe&quot;)}&#xA;    browser = cands.FirstOrDefault(Function(c) File.Exists(c))&#xA;End If&#xA;&#xA;out_PdfPath = &quot;&quot;&#xA;If browser Is Nothing OrElse browser = &quot;&quot; Then&#xA;    out_Summary = &quot;no Edge or Chrome found - the HTML audit report was kept, PDF skipped&quot;&#xA;    Exit Sub&#xA;End If&#xA;&#xA;Dim pdfPath As String = Path.ChangeExtension(in_HtmlPath, &quot;.pdf&quot;)&#xA;If File.Exists(pdfPath) Then File.Delete(pdfPath)&#xA;Dim profileDir As String = Path.Combine(Path.GetTempPath(), &quot;blv-pdf-profile&quot;)&#xA;Dim url As String = New Uri(in_HtmlPath).AbsoluteUri&#xA;&#xA;Dim psi As New ProcessStartInfo(browser)&#xA;psi.Arguments = String.Format(&quot;--headless=new --disable-gpu --no-first-run --user-data-dir=&quot;&quot;{0}&quot;&quot; &quot; &amp; _&#xA;    &quot;--no-pdf-header-footer --print-to-pdf=&quot;&quot;{1}&quot;&quot; &quot;&quot;{2}&quot;&quot;&quot;, profileDir, pdfPath, url)&#xA;psi.UseShellExecute = False&#xA;psi.CreateNoWindow = True&#xA;&#xA;Dim sw As Stopwatch = Stopwatch.StartNew()&#xA;Using proc As Process = Process.Start(psi)&#xA;    If Not proc.WaitForExit(90000) Then&#xA;        proc.Kill()&#xA;        out_Summary = &quot;browser did not finish within 90s - PDF skipped, HTML kept&quot;&#xA;        Exit Sub&#xA;    End If&#xA;End Using&#xA;&#xA;' The file can land a moment after the process exits; allow a brief settle.&#xA;Dim waited As Integer = 0&#xA;While (Not File.Exists(pdfPath) OrElse New FileInfo(pdfPath).Length = 0) AndAlso waited &lt; 5000&#xA;    Threading.Thread.Sleep(250)&#xA;    waited += 250&#xA;End While&#xA;&#xA;If File.Exists(pdfPath) AndAlso New FileInfo(pdfPath).Length &gt; 0 Then&#xA;    out_PdfPath = pdfPath&#xA;    out_Summary = String.Format(&quot;{0} written ({1:N0} KB, {2:N1}s via {3})&quot;, Path.GetFileName(pdfPath), _&#xA;        New FileInfo(pdfPath).Length / 1024.0, sw.Elapsed.TotalSeconds, Path.GetFileNameWithoutExtension(browser))&#xA;Else&#xA;    out_Summary = &quot;browser exited but produced no PDF - HTML audit report kept&quot;&#xA;End If"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[in_Config]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_HtmlPath">[htmlPath]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="out_PdfPath">[out_PdfPath]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_Summary">[summary]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If DisplayName="If - PDF produced" Condition="[out_PdfPath &lt;&gt; &quot;&quot;]"><If.Then><ui:LogMessage DisplayName="Log - [PDF]" Level="Info" Message="[&quot;[PDF] &quot; &amp; summary]" /></If.Then><If.Else><ui:LogMessage DisplayName="Log - [PDF]" Level="Warn" Message="[&quot;[PDF] &quot; &amp; summary]" /></If.Else></If></Sequence></If.Then><If.Else><Sequence DisplayName="PDF disabled"><ui:LogMessage DisplayName="Log - [PDF] PdfReportEnabled is False - HTML audit r" Level="Info" Message="[&quot;[PDF] PdfReportEnabled is False - HTML audit report only: &quot; &amp; htmlPath]" /></Sequence></If.Else></If></Sequence>
</Activity>
