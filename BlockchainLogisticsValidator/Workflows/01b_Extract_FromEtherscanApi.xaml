  <Sequence DisplayName="01b - Extract from Etherscan V2 API"><Sequence.Variables><Variable x:TypeArguments="x:String" Name="requestUrl" /><Variable x:TypeArguments="x:String" Name="safeUrl" /><Variable x:TypeArguments="x:String" Name="responseText" /><Variable x:TypeArguments="njl:JObject" Name="jsonObj" /><Variable x:TypeArguments="x:String" Name="summary" /></Sequence.Variables><ui:InvokeCode DisplayName="Invoke Code - build request URL" Language="VBNet" Code="' Etherscan V2 is multichain: the network is selected by `chainid`, not by a&#xA;' different host. Switching Ethereum -&gt; Polygon is therefore a single config cell,&#xA;' which is what makes the bot chain-agnostic in practice.&#xA;Dim baseUrl As String = Convert.ToString(in_Config(&quot;EtherscanBaseUrl&quot;)).TrimEnd(&quot;/&quot;c)&#xA;Dim chainId As String = Convert.ToString(in_Config(&quot;ChainId&quot;))&#xA;Dim address As String = Convert.ToString(in_Config(&quot;ContractAddress&quot;))&#xA;Dim apiKey As String = Convert.ToString(in_Config(&quot;EtherscanApiKey&quot;))&#xA;Dim maxTx As String = Convert.ToString(in_Config(&quot;MaxTransactions&quot;))&#xA;&#xA;out_Url = String.Format(&quot;{0}?chainid={1}&amp;module=account&amp;action=txlist&amp;address={2}&quot; &amp; _&#xA;                        &quot;&amp;startblock=0&amp;endblock=99999999&amp;page=1&amp;offset={3}&amp;sort=asc&amp;apikey={4}&quot;, _&#xA;                        baseUrl, chainId, address, maxTx, apiKey)&#xA;&#xA;' Never log the key itself.&#xA;out_SafeUrl = out_Url.Replace(apiKey, &quot;***REDACTED***&quot;)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[in_Config]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="out_Url">[requestUrl]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_SafeUrl">[safeUrl]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:LogMessage DisplayName="Log - [EXTRACT/API] GET" Level="Info" Message="[&quot;[EXTRACT/API] GET &quot; &amp; safeUrl]" /><ui:HttpClient DisplayName="HTTP Request - txlist" EndPoint="[requestUrl]" Method="GET" AcceptFormat="JSON" TimeoutMS="[60000]" Result="[responseText]" /><ui:DeserializeJson x:TypeArguments="njl:JObject" DisplayName="Deserialize JSON" JsonString="[responseText]" JsonObject="[jsonObj]" /><If DisplayName="If - Etherscan reported an error" Condition="[jsonObj(&quot;status&quot;) IsNot Nothing AndAlso Convert.ToString(jsonObj(&quot;status&quot;)) &lt;&gt; &quot;1&quot;]"><If.Then><Throw DisplayName="Throw" Exception="[New InvalidOperationException(&quot;Etherscan returned status=&quot; &amp; Convert.ToString(jsonObj(&quot;status&quot;)) &amp; &quot; message=&quot; &amp; Convert.ToString(jsonObj(&quot;message&quot;)) &amp; &quot;. A rate limit or an invalid key is the usual cause.&quot;)]" /></If.Then></If><ui:InvokeCode DisplayName="Invoke Code - select the transaction records" Language="VBNet" Code="' The transaction array's location is configuration (ChainRecordsPath), because&#xA;' explorers and exporters wrap it differently - Etherscan uses &quot;result&quot;, an&#xA;' ethereum-etl export uses &quot;transactions&quot;.&#xA;Dim p As String = If(in_RecordsPath, &quot;&quot;).Trim()&#xA;If p = &quot;&quot; Then p = &quot;result&quot;&#xA;Dim tok As JToken = in_Json.SelectToken(p)&#xA;If tok Is Nothing OrElse tok.Type &lt;&gt; JTokenType.Array Then&#xA;    Throw New InvalidOperationException(&quot;No transaction array at ChainRecordsPath '&quot; &amp; p &amp; _&#xA;        &quot;' in the chain response. Check ChainRecordsPath in Config.xlsx.&quot;)&#xA;End If&#xA;out_Records = CType(tok, JArray)&#xA;out_Summary = String.Format(&quot;{0} record(s) read from '{1}'&quot;, out_Records.Count, p)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="njl:JObject" x:Key="in_Json">[jsonObj]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_RecordsPath">[Convert.ToString(in_Config(&quot;ChainRecordsPath&quot;))]</InArgument><OutArgument x:TypeArguments="njl:JArray" x:Key="out_Records">[out_jRecords]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_Summary">[summary]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:LogMessage DisplayName="Log - [EXTRACT/API]" Level="Info" Message="[&quot;[EXTRACT/API] &quot; &amp; summary]" /></Sequence>
