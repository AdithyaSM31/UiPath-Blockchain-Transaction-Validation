Each c As DataColumn In dt.Columns&#xA;        Dim v As JToken = tok(c.ColumnName)&#xA;        If v Is Nothing OrElse v.Type = JTokenType.Null Then&#xA;            rw(c.ColumnName) = DBNull.Value&#xA;        ElseIf c.DataType Is GetType(DateTime) Then&#xA;            rw(c.ColumnName) = DateTime.Parse(v.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind)&#xA;        ElseIf c.DataType Is GetType(Boolean) Then&#xA;            rw(c.ColumnName) = Convert.ToBoolean(v.ToString())&#xA;        ElseIf c.DataType Is GetType(Long) Then&#xA;            rw(c.ColumnName) = Convert.ToInt64(v.ToString())&#xA;        ElseIf c.DataType Is GetType(Integer) Then&#xA;            rw(c.ColumnName) = Convert.ToInt32(v.ToString())&#xA;        Else&#xA;            rw(c.ColumnName) = v.ToString()&#xA;        End If&#xA;    Next&#xA;    dt.Rows.Add(rw)&#xA;Next&#xA;&#xA;out_dtJoined = dt&#xA;out_Summary = String.Format(&quot;{0} transaction(s) rehydrated&quot;, dt.Rows.Count)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="in_EventsJson">[Convert.ToString(CurrentPayload(&quot;EventsJson&quot;))]</InArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dtJoined">[dtJoined]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_Summary">[summary]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:InvokeWorkflowFile DisplayName="Invoke 05 - Validation engine" WorkflowFileName="Workflows\05_Validate_Engine.xaml"><ui:InvokeWorkflowFile.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[Config]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtJoined">[dtJoined]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtRules">[dtRules]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtWallets">[dtWallets]</InArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dtResults">[dtResults]</OutArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dtExceptions">[dtExceptions]</OutArgument><OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="out_Stats">[Stats]</OutArgument></scg:Dictionary></ui:InvokeWorkflowFile.Arguments></ui:InvokeWorkflowFile><ui:InvokeCode DisplayName="Invoke Code - merge into the job's results" Language="VBNet" Code="' Accumulate one shipment's verdicts into the job-wide results table.&#xA;If io_dtAll Is Nothing Then&#xA;    io_dtAll = in_dtResults.Clone()&#xA;    io_dtAll.TableName = &quot;ValidationResults&quot;&#xA;End If&#xA;For Each r As DataRow In in_dtResults.Rows&#xA;    io_dtAll.ImportRow(r)&#xA;Next"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtResults">[dtResults]</InArgument><InOutArgument x:TypeArguments="sd:DataTable" x:Key="io_dtAll">[dtAllResults]</InOutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><Assign DisplayName="Assign - count processed"><Assign.To><OutArgument x:TypeArguments="x:Int32">[itemsProcessed]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[itemsProcessed + 1]</InArgument></Assign.Value></Assign><ui:LogMessage DisplayName="Log - [PERFORM]" Level="Info" Message="[&quot;[PERFORM] &quot; &amp; shipmentId &amp; &quot;: &quot; &amp; Convert.ToString(Stats(&quot;Fail&quot;)) &amp; &quot; failure(s), &quot; &amp; Convert.ToString(Stats(&quot;Warning&quot;)) &amp; &quot; warning(s)&quot;]" /></Sequence></TryCatch.Try><TryCatch.Catches><Catch x:TypeArguments="s:Exception"><ActivityAction x:TypeArguments="s:Exception"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="exception" /></ActivityAction.Argument><Sequence DisplayName="Record the failure"><ui:LogMessage DisplayName="Log - [PERFORM]" Level="Error" Message="[&quot;[PERFORM] &quot; &amp; shipmentId &amp; &quot; failed: &quot; &amp; exception.Message]" /><Assign DisplayName="Assign - count failed"><Assign.To><OutArgument x:TypeArguments="x:Int32">[itemsFailed]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[itemsFailed + 1]</InArgument></Assign.Value></Assign></Sequence></ActivityAction></Catch></TryCatch.Catches></TryCatch></ActivityAction></ui:ForEachRow.Body></ui:ForEachRow></Sequence></If.Else></If><ui:LogMessage DisplayName="Log - [PERFORM]" Level="Info" Message="[&quot;[PERFORM] &quot; &amp; itemsProcessed.ToString() &amp; &quot; shipment(s) processed, &quot; &amp; itemsFailed.ToString() &amp; &quot; failed&quot;]" /><If DisplayName="If - anything processed" Condition="[dtAllResults IsNot Nothing AndAlso dtAllResults.Rows.Count &gt; 0]"><If.Then><Sequence DisplayName="Finalise the job"><ui:InvokeCode DisplayName="Invoke Code - job statistics" Language="VBNet" Code="' The job's statistics, recomputed from every shipment it validated - the same figures&#xA;' the validation engine produces for a batch run, so reports read identically.&#xA;Dim ruleName As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)&#xA;For Each rr As DataRow In in_dtRules.Rows&#xA;    ruleName(Convert.ToString(rr(&quot;RuleID&quot;)).Trim()) = Convert.ToString(rr(&quot;RuleName&quot;)).Trim()&#xA;Next&#xA;Dim nPass As Integer = 0, nWarn As Integer = 0, nFail As Integer = 0, nEsc As Integer = 0&#xA;Dim ruleHits As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)&#xA;For Each r As DataRow In in_dtResults.Rows&#xA;    Select Case Convert.ToString(r(&quot;ValidationStatus&quot;))&#xA;        Case &quot;PASS&quot; : nPass += 1&#xA;        Case &quot;WARNING&quot; : nWarn += 1&#xA;        Case &quot;FAIL&quot; : nFail += 1&#xA;    End Select&#xA;    If Convert.ToBoolean(r(&quot;RequiresEscalation&quot;)) Then nEsc += 1&#xA;    For Each rid As String In New String() {&quot;R1&quot;, &quot;R2&quot;, &quot;R3&quot;, &quot;R4&quot;, &quot;R5&quot;, &quot;R6&quot;}&#xA;        Dim st As String = Convert.ToString(r(rid &amp; &quot;_Status&quot;))&#xA;        If st = &quot;FAIL&quot; OrElse st = &quot;WARNING&quot; Then&#xA;            If Not ruleHits.ContainsKey(rid) Then ruleHits(rid) = 0&#xA;            ruleHits(rid) = ruleHits(rid) + 1&#xA;        End If&#xA;    Next&#xA;Next&#xA;Dim stats As New Dictionary(Of String, Object)(StringComparer.OrdinalIgnoreCase)&#xA;Dim total As Integer = in_dtResults.Rows.Count&#xA;stats(&quot;Total&quot;) = total&#xA;stats(&quot;Pass&quot;) = nPass&#xA;stats(&quot;Warning&quot;) = nWarn&#xA;stats(&quot;Fail&quot;) = nFail&#xA;stats(&quot;Escalations&quot;) = nEsc&#xA;stats(&quot;PassPercent&quot;) = If(total = 0, 0.0, Math.Round(nPass * 100.0 / total, 1))&#xA;Dim hits As New List(Of String)&#xA;For Each rid As String In New String() {&quot;R1&quot;, &quot;R2&quot;, &quot;R3&quot;, &quot;R4&quot;, &quot;R5&quot;, &quot;R6&quot;}&#xA;    Dim c As Integer = 0&#xA;    If ruleHits.ContainsKey(rid) Then c = ruleHits(rid)&#xA;    stats(rid &amp; &quot;_Hits&quot;) = c&#xA;    If c &gt; 0 Then hits.Add(rid &amp; &quot;(&quot; &amp; If(ruleName.ContainsKey(rid), ruleName(rid), rid) &amp; &quot;)=&quot; &amp; c.ToString())&#xA;Next&#xA;stats(&quot;RuleHitSummary&quot;) = String.Join(&quot;, &quot;, hits)&#xA;out_Stats = stats&#xA;out_Summary = String.Format(&quot;total={0} pass={1} warn={2} fail={3} escalations={4} | {5}&quot;, _&#xA;    total, nPass, nWarn, nFail, nEsc, String.Join(&quot;, &quot;, hits))"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtResults">[dtAllResults]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtRules">[dtRules]</InArgument><OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="out_Stats">[jobStats]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_Summary">[summary]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:LogMessage DisplayName="Log - [PERFORM]" Level="Info" Message="[&quot;[PERFORM] &quot; &amp; summary]" /><Assign DisplayName="Assign - mark end of Validate phase"><Assign.To><OutArgument x:TypeArguments="x:Object">[Config(&quot;Mark_Validate&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[DateTime.UtcNow]</InArgument></Assign.Value></Assign><ui:InvokeWorkflowFile DisplayName="Invoke 14 - Finalise run" WorkflowFileName="Workflows\14_Finalise_Run.xaml"><ui:InvokeWorkflowFile.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[Config]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtRules">[dtRules]</InArgument><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Stats">[jobStats]</InArgument><InOutArgument x:TypeArguments="sd:DataTable" x:Key="io_dtResults">[dtAllResults]</InOutArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dtExceptions">[dtExceptions]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_ReportPath">[reportPath]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_PdfPath">[pdfPath]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_DashboardPath">[dashboardPath]</OutArgument><OutArgument x:TypeArguments="x:Boolean" x:Key="out_ChainValid">[chainValid]</OutArgument></scg:Dictionary></ui:InvokeWorkflowFile.Arguments></ui:InvokeWorkflowFile></Sequence></If.Then><If.Else><ui:LogMessage DisplayName="Log - [PERFORM] Nothing was processed - no reports p" Level="Info" Message="[&quot;[PERFORM] Nothing was processed - no reports produced.&quot;]" /></If.Else></If></Sequence>
</Activity>
