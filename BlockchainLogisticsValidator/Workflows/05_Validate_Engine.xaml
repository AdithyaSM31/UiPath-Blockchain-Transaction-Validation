n = True&#xA;        End If&#xA;    End If&#xA;&#xA;    If Convert.ToString(r(&quot;R6_Status&quot;)) = &quot;FAIL&quot; OrElse Convert.ToString(r(&quot;R6_Status&quot;)) = &quot;WARNING&quot; Then&#xA;        Dim st As String = Convert.ToString(r(&quot;R6_Status&quot;))&#xA;        Dim sev As String = &quot;MEDIUM&quot;&#xA;        If ruleSeverity.ContainsKey(&quot;R6&quot;) Then sev = ruleSeverity(&quot;R6&quot;)&#xA;        reasons.Add(&quot;R6 &quot; &amp; st &amp; &quot;: &quot; &amp; Convert.ToString(r(&quot;R6_Detail&quot;)))&#xA;        If st = &quot;FAIL&quot; Then&#xA;            anyFail = True&#xA;            If order.IndexOf(sev) &gt; order.IndexOf(worstSev) Then worstSev = sev&#xA;            If ruleAction.ContainsKey(&quot;R6&quot;) AndAlso ruleAction(&quot;R6&quot;) = &quot;ESCALATE&quot; Then escalate = True&#xA;        Else&#xA;            anyWarn = True&#xA;        End If&#xA;    End If&#xA;&#xA;    If anyFail Then&#xA;        r(&quot;ValidationStatus&quot;) = &quot;FAIL&quot;&#xA;        nFail += 1&#xA;    ElseIf anyWarn Then&#xA;        r(&quot;ValidationStatus&quot;) = &quot;WARNING&quot;&#xA;        nWarn += 1&#xA;    Else&#xA;        r(&quot;ValidationStatus&quot;) = &quot;PASS&quot;&#xA;        nPass += 1&#xA;    End If&#xA;&#xA;    r(&quot;Severity&quot;) = worstSev&#xA;    r(&quot;FailureReasons&quot;) = String.Join(&quot; | &quot;, reasons)&#xA;    r(&quot;RequiresEscalation&quot;) = escalate&#xA;    If escalate Then nEsc += 1&#xA;&#xA;    For Each rid As String In New String() {&quot;R1&quot;, &quot;R2&quot;, &quot;R3&quot;, &quot;R4&quot;, &quot;R5&quot;, &quot;R6&quot;}&#xA;        Dim st As String = Convert.ToString(r(rid &amp; &quot;_Status&quot;))&#xA;        If st = &quot;FAIL&quot; OrElse st = &quot;WARNING&quot; Then&#xA;            If Not ruleHits.ContainsKey(rid) Then ruleHits(rid) = 0&#xA;            ruleHits(rid) = ruleHits(rid) + 1&#xA;        End If&#xA;    Next&#xA;&#xA;    If anyFail OrElse anyWarn Then dtEx.ImportRow(r)&#