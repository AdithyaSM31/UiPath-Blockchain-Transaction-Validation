nce DisplayName="Fail the test"><Throw DisplayName="Throw" Exception="[New Exception(&quot;TC08 field mapping is chain agnostic FAILED: &quot; &amp; failures)]" /></Sequence></If.Then><If.Else><Sequence DisplayName="Passed"><ui:LogMessage DisplayName="Log - [TEST] TC08 field mapping is chain agnostic -" Level="Info" Message="[&quot;[TEST] TC08 field mapping is chain agnostic - all assertions passed&quot;]" /></Sequence></If.Else></If></Sequence>
