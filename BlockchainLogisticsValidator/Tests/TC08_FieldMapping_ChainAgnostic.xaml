  <Sequence DisplayName="TC08 field mapping is chain agnostic"><Sequence.Variables><Variable x:TypeArguments="x:Boolean" Name="assertOk" /><Variable x:TypeArguments="x:String" Name="failures" /><Variable x:TypeArguments="x:String" Name="configPath" /><Variable x:TypeArguments="sd:DataTable" Name="dtMapEth" /><Variable x:TypeArguments="sd:DataTable" Name="dtMapEtl" /><Variable x:TypeArguments="njl:JArray" Name="ethRecords" /><Variable x:TypeArguments="njl:JArray" Name="etlRecords" /><Variable x:TypeArguments="sd:DataTable" Name="dtEth" /><Variable x:TypeArguments="sd:DataTable" Name="dtEtl" /><Variable x:TypeArguments="sd:DataTable" Name="dtBroken" /><Variable x:TypeArguments="sd:DataTable" Name="dtChain" /><Variable x:TypeArguments="x:String" Name="diffs" /><Variable x:TypeArguments="x:String" Name="mappingError" /></Sequence.Variables><ui:LogMessage DisplayName="Log - [TEST] TC08 field mapping is chain agnostic -" Level="Info" Message="[&quot;[TEST] TC08 field mapping is chain agnostic - starting&quot;]" /><Assign DisplayName="Assign - configPath"><Assign.To><OutArgument x:TypeArguments="x:String">[configPath]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[Path.Combine(Directory.GetCurrentDirectory(), &quot;Data&quot;, &quot;Config.xlsx&quot;)]</InArgument></Assign.Value></Assign><ui:ExcelApplicationScope DisplayName="Excel Application Scope - Config.xlsx" AutoSave="False" Visible="False" CreateNewFile="False" ReadOnly="True" WorkbookPath="[configPath]"><ui:ExcelApplicationScope.Body><ActivityAction x:TypeArguments="ui:WorkbookApplication"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="ui:WorkbookApplication" Name="ExcelWorkbookScope" /></ActivityAction.Argument><Sequence DisplayName="Read both mapping sheets"><ui:ExcelReadRange DisplayName="Read Range - FieldMapping" AddHeaders="True" DataTable="[dtMapEth]" Range="" SheetName="FieldMapping" /><ui:ExcelReadRange DisplayName="Read Range - FieldMapping_EvmEtl" AddHeaders="True" DataTable="[dtMapEtl]" Range="" SheetName="FieldMapping_EvmEtl" /></Sequence></ActivityAction></ui:ExcelApplicationScope.Body></ui:ExcelApplicationScope><ui:InvokeCode DisplayName="Invoke Code - read both mock feeds" Language="VBNet" Code="' The two real mock feeds: Etherscan txlist (Ethereum) and an ethereum-etl export&#xA;' (Hyperledger Besu). Every field name and two value formats differ between them.&#xA;Dim root As String = Directory.GetCurrentDirectory()&#xA;Dim eth As JObject = JObject.Parse(File.ReadAllText(Path.Combine(root, &quot;Data&quot;, &quot;Input&quot;, &quot;MockChain&quot;, &quot;etherscan_txlist_response.json&quot;)))&#xA;Dim etl As JObject = JObject.Parse(File.ReadAllText(Path.Combine(root, &quot;Data&quot;, &quot;Input&quot;, &quot;MockChain&quot;, &quot;evm_etl_besu_export.json&quot;)))&#xA;out_Eth = CType(eth(&quot;result&quot;), JArray)&#xA;out_Etl = CType(etl(&quot;transactions&quot;), JArray)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><OutArgument x:TypeArguments="njl:JArray" x:Key="out_Eth">[ethRecords]</OutArgument><OutArgument x:TypeArguments="njl:JArray" x:Key="out_Etl">[etlRecords]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ui:InvokeWorkflowFile DisplayName="Invoke 01d - map the Etherscan feed" WorkflowFileName="Workflows\01d_Apply_FieldMapping.xaml"><ui:InvokeWorkflowFile.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="njl:JArray" x:Key="in_jRecords">[ethRecords]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtMapping">[dtMapEth]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_SourceMode">[&quot;MOCK&quot;]</InArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dtChain">[dtEth]</OutArgument></scg:Dictionary></ui:InvokeWorkflowFile.Arguments></ui:InvokeWorkflowFile><ui:InvokeWorkflowFile DisplayName="Invoke 01d - map the ethereum-etl feed" WorkflowFileName="Workflows\01d_Apply_FieldMapping.xaml"><ui:InvokeWorkflowFile.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="njl:JArray" x:Key="in_jRecords">[etlRecords]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtMapping">[dtMapEtl]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_SourceMode">[&quot;MOCK&quot;]</InArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dtChain">[dtEtl]</OutArgument></scg:Dictionary></ui:InvokeWorkflowFile.Arguments></ui:InvokeWorkflowFile><ui:InvokeCode DisplayName="Invoke Code - compare the two tables" Language="VBNet" Code="' Compare every canonical column of every row. SourceMode is the only column allowed&#xA;' to be equal by construction, so it proves nothing and is left out.&#xA;Dim cols() As String = {&quot;TxHash&quot;, &quot;BlockNumber&quot;, &quot;EventTimestampUtc&quot;, &quot;SenderAddress&quot;, &quot;ContractAddress&quot;, _&#xA;                        &quot;EventSelector&quot;, &quot;ShipmentID&quot;, &quot;OnChainQty&quot;, &quot;PONumber&quot;, &quot;TxFailed&quot;, &quot;RawInput&quot;}&#xA;Dim diffs As New List(Of String)&#xA;If in_A.Rows.Count &lt;&gt; in_B.Rows.Count Then diffs.Add(&quot;row counts differ&quot;)&#xA;For i As Integer = 0 To Math.Min(in_A.Rows.Count, in_B.Rows.Count) - 1&#xA;    For Each c As String In cols&#xA;        If Not Object.Equals(in_A.Rows(i)(c), in_B.Rows(i)(c)) Then&#xA;            diffs.Add(String.Format(&quot;row {0} {1}: '{2}' vs '{3}'&quot;, i, c, in_A.Rows(i)(c), in_B.Rows(i)(c)))&#xA;        End If&#xA;    Next&#xA;Next&#xA;out_Diffs = String.Join(&quot;; &quot;, diffs.Take(5))"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="sd:DataTable" x:Key="in_A">[dtEth]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_B">[dtEtl]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="out_Diffs">[diffs]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ut:VerifyExpression DisplayName="Verify - all 48 Etherscan records are mapped" Expression="[dtEth.Rows.Count = 48]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'all 48 Etherscan records are mapped'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;all 48 Etherscan records are mapped; &quot;)]</InArgument></Assign.Value></Assign><ut:VerifyExpression DisplayName="Verify - all 48 ethereum-etl records are mapped" Expression="[dtEtl.Rows.Count = 48]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'all 48 ethereum-etl records are mapped'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;all 48 ethereum-etl records are mapped; &quot;)]</InArgument></Assign.Value></Assign><ut:VerifyExpression DisplayName="Verify - both schemas produce identical canonical transactions" Expression="[diffs = &quot;&quot;]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'both schemas produce identical canonical transactions'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;both schemas produce identical canonical transactions; &quot;)]</InArgument></Assign.Value></Assign><ut:VerifyExpression DisplayName="Verify - ABI string argument decoded" Expression="[Convert.ToString(dtEtl.Rows(0)(&quot;ShipmentID&quot;)) = &quot;SHP-1001&quot;]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'ABI string argument decoded'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;ABI string argument decoded; &quot;)]</InArgument></Assign.Value></Assign><ut:VerifyExpression DisplayName="Verify - ABI uint256 argument decoded" Expression="[Convert.ToInt64(dtEtl.Rows(0)(&quot;OnChainQty&quot;)) = 500]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'ABI uint256 argument decoded'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;ABI uint256 argument decoded; &quot;)]</InArgument></Assign.Value></Assign><ut:VerifyExpression DisplayName="Verify - timestamps are normalised to UTC" Expression="[Convert.ToDateTime(dtEtl.Rows(0)(&quot;EventTimestampUtc&quot;)).Kind = DateTimeKind.Utc]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'timestamps are normalised to UTC'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;timestamps are normalised to UTC; &quot;)]</InArgument></Assign.Value></Assign><ui:InvokeCode DisplayName="Invoke Code - mapping without ShipmentID" Language="VBNet" Code="Dim m As DataTable = in_Mapping.Copy()&#xA;For i As Integer = m.Rows.Count - 1 To 0 Step -1&#xA;    If Convert.ToString(m.Rows(i)(&quot;LogisticsField&quot;)) = &quot;ShipmentID&quot; Then m.Rows.RemoveAt(i)&#xA;Next&#xA;out_Mapping = m"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="sd:DataTable" x:Key="in_Mapping">[dtMapEth]</InArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Mapping">[dtBroken]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><TryCatch DisplayName="Try Catch - incomplete mapping must be rejected"><TryCatch.Try><Sequence DisplayName="Map with an incomplete sheet"><ui:InvokeWorkflowFile DisplayName="Invoke 01d - map the incomplete feed" WorkflowFileName="Workflows\01d_Apply_FieldMapping.xaml"><ui:InvokeWorkfl