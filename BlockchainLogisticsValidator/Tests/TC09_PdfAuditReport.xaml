26, 9, 1, 6, 0, 0, DateTimeKind.Utc)&#xA;Dim r1 As DataRow = dt.NewRow()&#xA;r1(&quot;RowNo&quot;) = 1 : r1(&quot;TxHash&quot;) = &quot;0x&quot; &amp; New String(&quot;a&quot;c, 64) : r1(&quot;ShipmentID&quot;) = &quot;SHP-T1&quot; : r1(&quot;EventName&quot;) = &quot;Dispatched&quot;&#xA;r1(&quot;SenderAddress&quot;) = &quot;0x&quot; &amp; New String(&quot;1&quot;c, 40) : r1(&quot;ErpHandlerPartner&quot;) = &quot;NordPharma&quot; : r1(&quot;PONumber&quot;) = &quot;PO-1&quot;&#xA;r1(&quot;Product&quot;) = &quot;Test vials&quot; : r1(&quot;MatchStatus&quot;) = &quot;MATCHED&quot;&#xA;For Each c As String In New String() {&quot;R1_Status&quot;, &quot;R2_Status&quot;, &quot;R3_Status&quot;, &quot;R4_Status&quot;, &quot;R5_Status&quot;, &quot;R6_Status&quot;}&#xA;    r1(c) = &quot;PASS&quot;&#xA;Next&#xA;r1(&quot;ValidationStatus&quot;) = &quot;PASS&quot; : r1(&quot;Severity&quot;) = &quot;NONE&quot; : r1(&quot;FailureReasons&quot;) = &quot;&quot;&#xA;r1(&quot;HumanDecision&quot;) = &quot;&quot; : r1(&quot;HumanDecidedBy&quot;) = &quot;&quot; : r1(&quot;HumanDecidedAtUtc&quot;) = &quot;&quot; : r1(&quot;InputDataHash&quot;) = New String(&quot;c&quot;c, 64)&#xA;r1(&quot;ChainTimestampUtc&quot;) = t : r1(&quot;ErpExpectedQty&quot;) = 500L : r1(&quot;OnChainQty&quot;) = 500L : r1(&quot;RequiresEscalation&quot;) = False&#xA;dt.Rows.Add(r1)&#xA;&#xA;' The second row carries the awkward content: parentheses and a backslash that PDF&#xA;' strings must escape, and a non-ASCII dash that must not corrupt byte offsets.&#xA;Dim r2 As DataRow = dt.NewRow()&#xA;r2(&quot;RowNo&quot;) = 2 : r2(&quot;TxHash&quot;) = &quot;0x&quot; &amp; New String(&quot;b&quot;c, 64) : r2(&quot;ShipmentID&quot;) = &quot;SHP-T2&quot; : r2(&quot;EventName&quot;) = &quot;Delivered&quot;&#xA;r2(&quot;SenderAddress&quot;) = &quot;0x&quot; &amp; New String(&quot;9&quot;c, 40) : r2(&quot;ErpHandlerPartner&quot;) = &quot;LastMile&quot; : r2(&quot;PONumber&quot;) = &quot;PO-2&quot;&#xA;r2(&quot;Product&quot;) = &quot;Test kits&quot; : r2(&quot;MatchStatus&quot;) = &quot;MATCHED&quot;&#xA;For Each c As String In New String() {&quot;R1_Status&quot;, &quot;R2_Status&quot;, &quot;R4_Status&quot;, &quot;R5_Status&quot;, &quot;R6_Status&quot;}&#xA;    r2(c) = &quot;PASS&quot;&#xA;Next&#xA;r2(&quot;R3_Status&quot;) = &quot;FAIL&quot;&#xA;r2(&quot;ValidationStatus&quot;) = &quot;FAIL&quot; : r2(&quot;Severity&quot;) = &quot;CRITICAL&quot;&#xA;r2(&quot;FailureReasons&quot;) = &quot;R3 FAIL: wallet (unregistered) \ not approved &quot; &amp; ChrW(8212) &amp; &quot; expected LastMile &quot; &amp; New String(&quot;x&quot;c, 300)&#xA;r2(&quot;HumanDecision&quot;) = &quot;&quot; : r2(&quot;HumanDecidedBy&quot;) = &quot;&quot; : r2(&quot;HumanDecidedAtUtc&quot;) = &quot;&quot; : r2(&quot;InputDataHash&quot;) = New String(&quot;d&quot;c, 64)&#xA;r2(&quot;ChainTimestampUtc&quot;) = t.AddHours(50) : r2(&quot;ErpExpectedQty&quot;) = 120L : r2(&quot;OnChainQty&quot;) = 120L : r2(&quot;RequiresEscalation&quot;) = True&#xA;dt.Rows.Add(r2)&#xA;&#xA;Dim stats As New Dictionary(Of String, Object)(StringComparer.OrdinalIgnoreCase)&#xA;stats(&quot;Total&quot;) = 2 : stats(&quot;Pass&quot;) = 1 : stats(&quot;Warning&quot;) = 0 : stats(&quot;Fail&quot;) = 1 : stats(&quot;Escalations&quot;) = 1&#xA;stats(&quot;PassPercent&quot;) = 50.0 : stats(&quot;RuleHitSummary&quot;) = &quot;R3(AddressWhitelist)=1&quot;&#xA;For Each rid As String In New String() {&quot;R1&quot;, &quot;R2&quot;, &quot;R3&quot;, &quot;R4&quot;, &quot;R5&quot;, &quot;R6&quot;}&#xA;    stats(rid &amp; &quot;_Hits&quot;) = If(rid = &quot;R3&quot;, 1, 0)&#xA;Next&#xA;&#xA;Dim ex As DataTable = dt.Clone()&#xA;ex.ImportRow(r2)&#xA;&#xA;' A private output folder, so a test never touches the project's real reports.&#xA;Dim folder As String = Path.Combine(Path.GetTempPath(), &quot;blv_tests_&quot; &amp; Guid.NewGuid().ToString(&quot;N&quot;))&#xA;Directory.CreateDirectory(folder)&#xA;&#xA;out_dt = dt&#xA;out_Exceptions = ex&#xA;out_Stats = stats&#xA;out_Folder = folder"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dt">[dtResults]</OutArgument><OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Exceptions">[dtExceptions]</OutArgument><OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="out_Stats">[Stats]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="out_Folder">[testFolder]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><Assign DisplayName="Assign - test reports folder"><Assign.To><OutArgument x:TypeArguments="x:Object">[Config(&quot;ReportsFolder&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[testFolder]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign - test screenshot folder"><Assign.To><OutArgument x:TypeArguments="x:Object">[Config(&quot;ScreenshotFolder&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[testFolder]</InArgument></Assign.Value></Assign><ui:InvokeWorkflowFile DisplayName="Invoke 08 - write the PDF" WorkflowFileName="Workflows\08_Report_PDF.xaml"><ui:InvokeWorkflowFile.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[Config]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtResults">[dtResults]</InArgument><InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtRules">[dtRules]</InArgument><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Stats">[Stats]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_AuditPath">[&quot;C:\\audit\\ValidationAuditLog.csv&quot;]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_HeadHash">[New String(&quot;e&quot;c, 64)]</InArgument><InArgument x:TypeArguments="x:Boolean" x:Key="in_ChainValid">[True]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_ChainReport">[&quot;VALID - 2 entries verified (test)&quot;]</InArgument><InArgument x:TypeArguments="x:String" x:Key="in_ReportPath">[&quot;&quot;]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="out_PdfPath">[pdfPath]</OutArgument></scg:Dictionary></ui:InvokeWorkflowFile.Arguments></ui:InvokeWorkflowFile><ut:VerifyExpression DisplayName="Verify - the PDF is written" Expression="[File.Exists(pdfPath)]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'the PDF is written'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;the PDF is written; &quot;)]</InArgument></Assign.Value></Assign><ui:InvokeCode DisplayName="Invoke Code - inspect the PDF structure" Language="VBNet" Code="' Structural checks a PDF reader relies on: header, trailer, a cross-reference table&#xA;' whose every offset lands on the object it names, and a page count that matches.&#xA;Dim bytes() As Byte = File.ReadAllBytes(in_Path)&#xA;Dim text As String = Encoding.ASCII.GetString(bytes)&#xA;Dim problems As New List(Of String)&#xA;If Not text.StartsWith(&quot;%PDF-1.4&quot;) Then problems.Add(&quot;missing %PDF-1.4 header&quot;)&#xA;If Not text.EndsWith(&quot;%%EOF&quot; &amp; vbLf) Then problems.Add(&quot;missing %%EOF trailer&quot;)&#xA;If bytes.Any(Function(b) b &gt; 127) Then problems.Add(&quot;non-ASCII byte present&quot;)&#xA;&#xA;Dim sx As Integer = text.LastIndexOf(&quot;startxref&quot;)&#xA;Dim xrefAt As Integer = Integer.Parse(text.Substring(sx + 9).Trim().Split(ChrW(10))(0))&#xA;If Not text.Substring(xrefAt).StartsWith(&quot;xref&quot;) Then problems.Add(&quot;startxref does not point at the xref table&quot;)&#xA;&#xA;Dim xrefLines() As String = text.Substring(xrefAt).Split(ChrW(10))&#xA;Dim count As Integer = Integer.Parse(xrefLines(1).Split(&quot; &quot;c)(1))&#xA;For i As Integer = 1 To count - 1&#xA;    Dim entry As String = xrefLines(1 + i + 1)&#xA;    Dim off As Integer = Integer.Parse(entry.Substring(0, 10))&#xA;    If Not text.Substring(off).StartsWith(i.ToString() &amp; &quot; 0 obj&quot;) Then problems.Add(&quot;xref entry &quot; &amp; i.ToString() &amp; &quot; is misplaced&quot;)&#xA;Next&#xA;&#xA;Dim pages As Integer = System.Text.RegularExpressions.Regex.Matches(text, &quot;/Type /Page /Parent&quot;).Count&#xA;Dim declared As Integer = Integer.Parse(System.Text.RegularExpressions.Regex.Match(text, &quot;/Count (\d+)&quot;).Groups(1).Value)&#xA;If pages = 0 OrElse pages &lt;&gt; declared Then problems.Add(String.Format(&quot;page count mismatch: {0} page objects, /Count {1}&quot;, pages, declared))&#xA;&#xA;out_Problems = String.Join(&quot;; &quot;, problems)&#xA;out_Pages = pages"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="in_Path">[pdfPath]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="out_Problems">[problems]</OutArgument><OutArgument x:TypeArguments="x:Int32" x:Key="out_Pages">[pageCount]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><ut:VerifyExpression DisplayName="Verify - the PDF header, xref table, objects and page tree are consistent" Expression="[problems = &quot;&quot;]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'the PDF header, xref table, objects and page tree are consistent'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;the PDF header, xref table, objects and page tree are consistent; &quot;)]</InArgument></Assign.Value></Assign><ut:VerifyExpression DisplayName="Verify - the report has at least one page" Expression="[pageCount &gt;= 1]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'the report has at least one page'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;the report has at least one page; &quot;)]</InArgument></Assign.Value></Assign><ut:VerifyExpression DisplayName="Verify - the file is named after the run" Expression="[Path.GetFileName(pdfPath).StartsWith(&quot;AuditReport_&quot;)]" Result="[assertOk]" /><Assign DisplayName="Assign - track 'the file is named after the run'"><Assign.To><OutArgument x:TypeArguments="x:String">[failures]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(assertOk, failures, failures &amp; &quot;the file is named after the run; &quot;)]</InArgument></Assign.Value></Assign><ui:InvokeCode DisplayName="Invoke Code - remove the test folder" Language="VBNet" Code="If Directory.Exists(in_Folder) Then Directory.Delete(in_Folder, True)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="in_Folder">[testFolder]</InArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If DisplayName="If - any assertion failed" Condition="[failures &lt;&gt; &quot;&quot;]"><If.Then><Sequence DisplayName="Fail the test"><Throw DisplayName="Throw" Exception="[New Exception(&quot;TC09 PDF audit report structure FAILED: &quot; &amp; failures)]" /></Sequence></If.Then><If.Else><Sequence DisplayName="Passed"><ui:LogMessage DisplayName="Log - [TEST] TC09 PDF audit report structure - all a" Level="Info" Message="[&quot;[TEST] TC09 PDF audit report structure - all assertions passed&quot;]" /></Sequence></If.Else></If></Sequence>
